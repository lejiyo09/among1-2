# 모두 선택 사항이다. 비워 두면 기본값을 쓴다. 비밀 키는 필요 없다.
# Render 에서는 대시보드 → Environment 에 같은 이름으로 넣는다. (.env 파일은 서버가 자동으로 읽지 않는다)

# HTTP/WebSocket 포트. Render 가 자동으로 지정하므로 Render 에서는 넣지 않는다
PORT=3000

# 게임 시작 최소 인원 (원작 4, 테스트할 때만 2)
MIN_PLAYERS=4

# 프런트엔드를 다른 주소(예: GitHub Pages)에 따로 올릴 때만, 그 주소를 쉼표로 구분해 적는다
# 비워 두면 같은 서버에서 받은 페이지의 접속만 허용한다
ALLOWED_ORIGINS=

# 동시에 열 수 있는 방 수 / 전체 연결 수 / IP 하나당 연결 수 (학교처럼 같은 IP 를 공유하면 넉넉하게)
MAX_ROOMS=100
MAX_CONNECTIONS=600
MAX_CONNECTIONS_PER_IP=60

# debug | info | warn | error
LOG_LEVEL=info
